# --- Azure account (required) ---
# Subscription that holds the cluster and registry
AZURE_SUBSCRIPTION_ID=
# Azure AD tenant used to log in
AZURE_TENANT_ID=

# --- Azure service principal (CI only) ---
# Leave empty locally: `az login` is used instead
# Service principal / OIDC app ID
AZURE_CLIENT_ID=
# Service principal secret (not needed with OIDC)
AZURE_CLIENT_SECRET=

# --- Azure resources (required) ---
# Resource group of the AKS cluster and ACR
AZURE_RESOURCE_GROUP=
# Cluster to deploy to (az aks get-credentials)
AZURE_AKS_CLUSTER_NAME=
# Private registry the images are pushed to (<name>.azurecr.io)
AZURE_ACR_NAME=

# --- Bootstrap only (scripts/bootstrap_azure.py) ---
# Region for the new resources (e.g. westeurope)
AZURE_LOCATION=
# Number of AKS nodes, keep small to save credits
AZURE_AKS_NODE_COUNT=

# --- Deployment (optional) ---
# Target namespace, defaults to "poll"
NAMESPACE=
# Image tag, defaults to the current git commit SHA
IMAGE_TAG=

# --- Secrets (required) ---
# Stored in a Kubernetes Secret created at deploy time
POSTGRES_PASSWORD=

# Secrets (optional)
# If dont set that will run without password
REDIS_PASSWORD=