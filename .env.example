# Settings for scripts/bernstein (see docs/scripts.md).
# Real environment variables override this file; empty values use the default.

# --- Azure account ---
# Subscription that holds the cluster and registry (default: the az CLI's current one)
AZURE_SUBSCRIPTION_ID=
# Azure AD tenant used to log in
AZURE_TENANT_ID=

# --- Azure service principal (CI only) ---
# Leave empty locally: `az login` is used instead
# Service principal / OIDC app ID
AZURE_CLIENT_ID=
# Service principal secret (not needed with OIDC)
AZURE_CLIENT_SECRET=

# --- Azure resources ---
# Resource group of the AKS cluster and ACR, created if missing, never deleted (default: Bernstein)
AZURE_RESOURCE_GROUP=
# Cluster to deploy to (default: bernstein-aks)
AZURE_AKS_CLUSTER_NAME=
# Private registry the images are pushed to (<name>.azurecr.io).
# Left empty, `bernstein registry create` generates one and writes it here.
AZURE_ACR_NAME=

# --- Cluster creation (bernstein preflight / cluster create) ---
# Region for new resources (default: spaincentral)
AZURE_LOCATION=
# Number of AKS nodes, keep small to save credits (default: 2)
AZURE_AKS_NODE_COUNT=
# Node VM size (default: Standard_B2s_v2)
AZURE_AKS_VM_SIZE=
# Node OS disk in GB (default: 64)
AZURE_AKS_OS_DISK_GB=
# Extra nodes during node image upgrades, a number or a percentage (default: 1)
AZURE_AKS_MAX_SURGE=
# Node pool name (default: system)
AZURE_AKS_NODEPOOL=
# cilium, azure, calico or none (default: cilium)
AZURE_AKS_NETWORK_POLICY=
# Registry SKU (default: Basic)
AZURE_ACR_SKU=

# --- Deployment (optional) ---
# Target namespace (default: poll)
NAMESPACE=
# Helm release name (default: poll-app)
HELM_RELEASE=
# kubectl context (default: the cluster name, as written by az aks get-credentials)
KUBE_CONTEXT=
# Namespace of the Traefik release (default: traefik)
TRAEFIK_NAMESPACE=
# Ingress hostnames (default: poll.<traefik-ip>.nip.io and result.<traefik-ip>.nip.io)
POLL_HOST=
RESULT_HOST=
# Image tag (default: the current git commit SHA)
IMAGE_TAG=

# --- Availability probe (optional) ---
# Requests per second per probed URL (default: 5)
PROBE_RATE=
# Request timeout in seconds; slower counts as a failure (default: 2)
PROBE_TIMEOUT=

# --- Secrets ---
# Required: stored in the Kubernetes Secret postgres-secret at deploy time
POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_DB=
# Optional: when set, Redis requires this password (Secret redis-secret);
# when empty, Redis runs without a password
REDIS_PASSWORD=
